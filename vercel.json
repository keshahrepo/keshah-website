{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/support/draft",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/support/learn",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/rc/sync-attributes",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/rc/backfill-attribution",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/interview/follow-up",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/interview/reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/creator-posts",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/creator-posts-deep",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/creator-nudge",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/stats-recount",
      "schedule": "30 4 * * 1"
    },
    {
      "path": "/api/cron/creator-invoices",
      "schedule": "0 9 * * *"
    }
  ]
}
